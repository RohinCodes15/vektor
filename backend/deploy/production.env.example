# Production settings for a container or VM (Phase 5A). Copy, fill in, and give to your host as environment
# variables. Paper-only: VEKTOR_TRADING_MODE accepts only "paper", and there are no broker settings.
# Startup fails, naming each missing setting, if a required one below is absent.
VEKTOR_ENVIRONMENT=production
VEKTOR_TRADING_MODE=paper
# Required: exact https origins of your frontend (JSON list). [] allows no browser origin.
VEKTOR_CORS_ORIGINS=["https://your-frontend.example"]
# Required: files on persistent storage. Without a persistent disk, everything here is lost on restart.
VEKTOR_PORTFOLIO_DB_PATH=/data/portfolios.sqlite3
VEKTOR_BACKTEST_DB_PATH=/data/backtests.sqlite3
# Optional (disposable cache), but keep it on the same disk to spare Yahoo Finance repeat requests.
VEKTOR_MARKET_DATA_CACHE_PATH=/data/market_data.sqlite3
VEKTOR_LOG_LEVEL=INFO
# Optional AI analysis is paid and off by default. With "anthropic", set VEKTOR_AI_API_KEY as a host secret,
# never in a file in the repository.
VEKTOR_AI_PROVIDER=none
# Public mode (the production default): paper portfolio writes and the stored-backtest listing need the owner key,
# sent as X-Vektor-Owner-Key. Set VEKTOR_OWNER_KEY (32+ random characters) as a host secret, never in a file here.
VEKTOR_PUBLIC_MODE=true
# Limits; the general rate limit is lowered from its 300 default to bound bandwidth costs on a public host.
VEKTOR_RATE_LIMIT_PER_MINUTE=60
VEKTOR_EXPENSIVE_RATE_LIMIT_PER_MINUTE=30
VEKTOR_MAX_CONCURRENT_EXPENSIVE_REQUESTS=4
VEKTOR_MAX_REQUEST_BODY_BYTES=65536
# Reverse proxies in front of the API that append to X-Forwarded-For (1 behind one platform proxy such as Fly.io).
# Rate limits key on the address the outermost of them appended. Use 0 only when clients connect directly.
VEKTOR_TRUSTED_PROXY_HOPS=1
# Also set FORWARDED_ALLOW_IPS for uvicorn on the host (not in this file: Vektor rejects unknown keys in .env).
# See backend/DEPLOYMENT.md.
