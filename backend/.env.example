# Copy to backend/.env. All values are optional; defaults shown.
# Vektor is paper-only: there are no broker settings, and unknown keys are rejected.
VEKTOR_APP_NAME=Vektor
VEKTOR_ENVIRONMENT=development
VEKTOR_LOG_LEVEL=INFO
# Left unset, these follow VEKTOR_ENVIRONMENT. Development: the two local frontends below and docs on.
# Production: no origins and docs off. Set them only to override, with exact https origins (no wildcard, no path).
# VEKTOR_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# VEKTOR_DOCS_ENABLED=true
VEKTOR_TRADING_MODE=paper
# Local SQLite cache for historical prices (relative paths resolve from the working directory).
VEKTOR_MARKET_DATA_CACHE_PATH=data/market_data.sqlite3
VEKTOR_MARKET_DATA_CACHE_TTL_HOURS=24
# Local SQLite database for paper portfolios, positions, and transactions. Not a cache: do not delete it casually.
VEKTOR_PORTFOLIO_DB_PATH=data/portfolios.sqlite3
# Local SQLite database for completed backtest results.
VEKTOR_BACKTEST_DB_PATH=data/backtests.sqlite3
# Optional AI explanations of backtests (Phase 3A.1). Off by default: "none" keeps Vektor local and free.
# "anthropic" calls Claude, a paid service billed to your Anthropic account. Never commit a real key.
VEKTOR_AI_PROVIDER=none
VEKTOR_AI_MODEL=claude-opus-5-5
# Leave unset to use the Anthropic SDK's own ANTHROPIC_API_KEY.
# VEKTOR_AI_API_KEY=
VEKTOR_AI_TIMEOUT_SECONDS=120
# Resource limits (Phase 4A). Rate limits are per client IP per minute; 0 turns one off.
VEKTOR_MAX_REQUEST_BODY_BYTES=65536
VEKTOR_RATE_LIMIT_PER_MINUTE=300
# Expensive requests: every POST under /api/v1/backtests (backtests, comparisons, optimizations, AI analysis).
VEKTOR_EXPENSIVE_RATE_LIMIT_PER_MINUTE=30
VEKTOR_MAX_CONCURRENT_EXPENSIVE_REQUESTS=4
# Longest start-to-end span for backtests, comparisons, and optimizations (about 20 years).
VEKTOR_MAX_BACKTEST_RANGE_DAYS=7305
